# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build output
build/
dist/
*.spec
!one_link.spec  # checked-in PyInstaller spec, if any
src/one_link/native/*/ol_native_cdc.c

# Local runtime data (NEVER commit identity keys or message logs)
*.key
identity.key
control.port
peer.port
inbox/
messages.jsonl
peers.json
# Bundle 24+: encrypted .olbak backup bundles. Encrypted to a
# specific master seed; never tracked.
*.olbak
# Bundle 35: social-recovery share files. Encrypted to recipient,
# but still per-setup state — never tracked.
*.olshare
# Bundle 23: master seed file + DRK + lockbox salt. DPAPI-wrapped
# on Windows, mode 0600 on POSIX. Never tracked under any platform.
master.seed
data-root-key.bin
lockbox.salt
# Local development scratch
shares/
final_link_err.txt

# Smoke test scratch
.smoke_tmp/

# Coverage
.coverage
htmlcov/

# stray daemon-test log files
_exe_test.log
*.log
